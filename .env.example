# Aegis Scanner — environment configuration template
#
# Copy this file to `.env` and adjust the values for your machine.
# `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# The application reads these through `os.environ`; nothing here is required
# for local use, but every value should be set explicitly before any
# deployment beyond localhost.

# ---------------------------------------------------------------------------
# Flask session signing key.
#
# Leave unset for local development and the app falls back to a random
# `os.urandom(32)` value generated at start-up — secure, but it invalidates
# sessions on every restart. Set it explicitly anywhere persistence matters.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
SECRET_KEY=

# ---------------------------------------------------------------------------
# Werkzeug interactive debugger and auto-reloader.
#
# Defaults to false. `true` exposes an interactive Python console on any
# unhandled exception — only ever enable it on a machine you fully control,
# and never on a host reachable from a network.
# ---------------------------------------------------------------------------
FLASK_DEBUG=false
